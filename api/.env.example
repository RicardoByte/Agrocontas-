# ==========================
# AgroContas — Backend .env
# ==========================
# 

# --- Gemini API ---
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="Chave da API do Gemini"

# Modelo usado na extração. Modelos antigos são desligados pelo Google
GEMINI_MODEL=gemini-3.8-flash

# Modelo reserva usado se o principal der 503 (sobrecarga) ou 404. Vazio = desativado.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Banco de Dados PostgreSQL ---
DATABASE_URL=postgresql://agrocontas_user:senha_segura@localhost:5432/agrocontas_db

# --- Configurações da API ---
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Tamanho máximo de upload (bytes) ---
MAX_UPLOAD_SIZE_MB=10

# --- Ambiente ---
ENVIRONMENT=development
